POSTGRES_DB=ganttai
POSTGRES_USER=ganttai
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://ganttai:REPLACE_WITH_URL_SAFE_PASSWORD@postgres:5432/ganttai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_OUTPUT_TOKENS=2000
HTTP_PORT=80
# Same-origin production traffic needs no CORS. Comma-separate trusted origins only for split-origin deployments.
CORS_ORIGINS=
